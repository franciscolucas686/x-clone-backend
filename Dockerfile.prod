# Build de produção em dois estágios: as dependências são compiladas no primeiro e
# só os artefatos vão para o segundo. O Dockerfile anterior era um estágio só e
# deixava gcc, build-essential e libpq-dev na imagem final — ferramentas de build
# que, além do tamanho, ampliam a superfície de ataque de um contêiner em produção.
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.12-slim AS production

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=backend.settings.production

# netcat-openbsd é usado pelo entrypoint para esperar o banco; nada além disso.
RUN apt-get update \
    && apt-get install -y --no-install-recommends netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

WORKDIR /app
COPY . .

COPY ./entrypoint.prod.sh /entrypoint.prod.sh
RUN chmod +x /entrypoint.prod.sh

# Usuário sem privilégios. O contêiner rodava como root: qualquer execução de código
# arbitrária dentro dele começaria com permissão total.
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/staticfiles \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

ENTRYPOINT ["/entrypoint.prod.sh"]

# $PORT com fallback: o Render injeta a porta em runtime, e o comando anterior fixava
# 8000 — o contêiner escutava numa porta e a plataforma encaminhava para outra.
#
# WEB_CONCURRENCY com default 2, não 3. Cada worker do gunicorn é um processo Django
# completo, e os planos gratuitos de Render e Koyeb dão 512 MB: três processos nesse teto
# levam o contêiner a ser morto por falta de memória sob a primeira carga real. Quem
# tiver mais RAM sobe o número pela variável, sem editar a imagem.
CMD ["sh", "-c", "gunicorn backend.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers ${WEB_CONCURRENCY:-2} --log-level info"]
