# ─────────────────────────────────────────────────────────────────────────────
#  Setup local: copie este arquivo para .env
#
#      cp .env.example .env
#
#  Os valores abaixo já funcionam com o `docker compose up` deste repositório.
#  Copie e rode — não precisa preencher nada.
#
#  O .env NÃO é versionado (ver .gitignore). Em produção não existe arquivo algum:
#  Render/Fly injetam as variáveis direto no processo.
#
#  Em desenvolvimento quase tudo aqui é opcional — backend/settings/development.py
#  tem defaults para todos. Em produção nada tem default: cada variável exigida por
#  backend/settings/production.py aborta o boot com o próprio nome se faltar.
# ─────────────────────────────────────────────────────────────────────────────

# Qual módulo de settings carregar. Deixe ausente em desenvolvimento: manage.py,
# wsgi.py e asgi.py já caem em backend.settings.development. Produção define
# backend.settings.production explicitamente (ver Dockerfile.prod).
#
# DJANGO_SETTINGS_MODULE=backend.settings.development

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Duas formas, e a primeira vence quando existe:
#
#   1. DATABASE_URL — uma string só. É o que Neon, Render e Supabase entregam no
#      painel: copie e cole, sem separar em pedaços. Formato:
#      postgresql://usuario:senha@host:5432/banco?sslmode=require
#
#   2. As quatro variáveis abaixo, para quando o banco é local.
#
# Em produção uma das duas é obrigatória; sem nenhuma, o boot aborta.
# DATABASE_URL=

# Estes valores batem com o serviço `db` do docker-compose.yml deste repositório.
#
# HOST: use "localhost" ao rodar `manage.py` na sua máquina (o caminho do README) e
# "db" ao rodar dentro do docker-compose, onde esse é o nome do serviço e o único
# nome que resolve.
DATABASE_NAME=xclone_dev
DATABASE_USER=xclone
DATABASE_PASSWORD=xclone
DATABASE_HOST=localhost
DATABASE_PORT=5432

# TLS na conexão com o banco. Em desenvolvimento o Postgres do compose não tem TLS, e o
# default é "prefer". Em produção o default é "require", porque todo Postgres gerenciado
# exige TLS e "prefer" cai para texto puro em silêncio se o handshake falhar.
# DATABASE_SSLMODE=

# ─── Segredo ─────────────────────────────────────────────────────────────────
# Em desenvolvimento é opcional: development.py usa um default propositalmente
# óbvio, porque aqui a chave não protege nada.
#
# Em produção é obrigatória e precisa ter no mínimo 50 caracteres. Gere a real com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# O valor anterior era o literal "unsafe-default-key", embutido em base.py: sem a
# variável, produção subia assinando os JWT com uma chave pública do repositório.
# SECRET_KEY=

# ─── CORS e hosts (só produção) ──────────────────────────────────────────────
# Em desenvolvimento, ALLOWED_HOSTS é ["*"] e o CORS é liberado — o proxy do Vite
# mantém tudo na mesma origem de qualquer jeito.
#
# Em produção as duas são obrigatórias e são listas separadas por vírgula.
# CORS_ALLOWED_ORIGINS recusa "*" explicitamente. Nenhuma das duas pode voltar para
# dentro do código: o domínio do deploy já esteve escrito em production.py, junto
# de localhost:5173 — que ficava aceito como origem em produção.
#
# CORS_ALLOWED_ORIGINS: SEM barra no fim. Uma origem é só esquema+host+porta, nunca um
# caminho — "https://seu-front.vercel.app/" derruba o boot com corsheaders.E014. O
# valor é normalizado (a barra é removida sozinha), mas escreva sem ela mesmo assim.
# ALLOWED_HOSTS=api.seudominio.com
# CORS_ALLOWED_ORIGINS=https://seu-front.vercel.app

# ─── Armazenamento de imagens (só produção) ──────────────────────────────────
# O upload de avatar usa a API do Cloudinary. Em desenvolvimento não é configurado:
# o backend recusa o upload com um erro claro em vez de quebrar (ver
# accounts/services.py), e o avatar padrão continua funcionando.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# URL do avatar usado por quem não tem foto (avatar == "" no banco). Só existe aqui:
# o frontend recebe o valor já resolvido em `avatar_url` (AvatarUrlField, em
# accounts/serializers.py) e não guarda mais uma cópia da string — antes ela estava
# escrita à mão nos dois repositórios e podia divergir em silêncio.
# DEFAULT_AVATAR_URL=

# ─── Seed de demonstração ────────────────────────────────────────────────────
# Libera `python manage.py seed_demo`. O comando tem duas travas independentes:
# recusa rodar com settings de produção, e exige esta variável como "true".
#
# Elas existem porque entrypoint.prod.sh executava o seed a cada boot, e o seed
# começava apagando User, Post, Like, Comment e Follow — todo deploy destruía os
# dados reais.
RUN_SEED=true

# Base para as URLs dos avatares de seed (media/avatars/), que o Django serve
# localmente em DEBUG. Só importa se você acessar a API por um endereço diferente de
# localhost:8000 — por exemplo, de outra máquina na rede ou por um túnel.
# LOCAL_MEDIA_BASE_URL=http://localhost:8000

# Senha das contas criadas pelo seed. As anteriores estavam em texto puro no
# repositório, para contas que existiam na aplicação publicada.
DEMO_USER_PASSWORD=SenhaDemo123!

# ─── Superusuário do admin ───────────────────────────────────────────────────
# Se as duas estiverem definidas, `manage.py ensure_superuser` cria a conta caso
# ela ainda não exista. A senha só é alterada com --update-password: um deploy não
# deve trocar credencial sem alguém pedir.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_NAME=Administrador
